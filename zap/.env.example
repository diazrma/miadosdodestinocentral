# copie para zap/.env e preencha (o .env não vai para o git)
# endereço da Central na Vercel, sem barra no fim
CENTRAL_URL=https://SUA-CENTRAL.vercel.app
# a mesma chave que for colocada em ZAP_KEY na Vercel (gere com: openssl rand -hex 24)
ZAP_KEY=
# chave da Evolution API que já roda nesta máquina (AUTHENTICATION_API_KEY do projeto ../Evolution API)
EVO_KEY=
# nome da instância do bot dentro dessa Evolution API (padrão: bigode)
EVO_INSTANCIA=bigode
