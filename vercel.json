{
  "functions": {
    "api/sync.js": {
      "maxDuration": 60
    },
    "api/publicar.js": {
      "maxDuration": 60
    },
    "api/sussurro.js": {
      "maxDuration": 60,
      "includeFiles": "{fonts,sussurro}/**"
    },
    "api/meme.js": {
      "maxDuration": 60
    },
    "api/redes.js": {
      "maxDuration": 60
    },
    "api/backup.js": {
      "maxDuration": 60
    },
    "api/webhook.js": {
      "maxDuration": 60
    },
    "api/bot.js": {
      "maxDuration": 60
    },
    "api/teste-app.js": {
      "maxDuration": 60,
      "includeFiles": "{fonts,teste-app}/**"
    },
    "api/loja.js": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "{fonts/**,loja-story/**,node_modules/ffmpeg-static/ffmpeg}"
    },
    "api/varal.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/sussurro",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/redes?horario=a",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/redes?horario=b",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/redes?horario=c",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/webhook?tick=1",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/teste-app",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/loja",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/loja?story=1",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/instagram/retorno",
      "destination": "/api/instagram?retorno=1"
    },
    {
      "source": "/tiktok/retorno",
      "destination": "/api/redes?acao=tiktok_retorno"
    },
    {
      "source": "/midia/:arquivo",
      "destination": "/api/redes?arquivo=:arquivo"
    },
    {
      "source": "/l/:k",
      "destination": "/api/webhook?l=:k"
    }
  ]
}
