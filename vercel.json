{
  "functions": {
    "api/[rota].js": {
      "maxDuration": 300,
      "includeFiles": "{fonts/**,sussurro/**,teste-app/**,loja-story/**,varal-post/**,node_modules/ffmpeg-static/ffmpeg}"
    }
  },
  "crons": [
    {
      "path": "/api/gazeta",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/sussurro",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/redes?horario=a",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/redes?horario=b",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/redes?horario=c",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/teste-app",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/loja",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/loja?story=1",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/varal?post=1",
      "schedule": "0 15 * * 0"
    },
    {
      "path": "/api/milka-cast?post=1",
      "schedule": "0 20 * * 4,6"
    }
  ],
  "rewrites": [
    {
      "source": "/instagram/retorno",
      "destination": "/api/instagram?retorno=1"
    },
    {
      "source": "/youtube/retorno",
      "destination": "/api/youtube?retorno=1"
    },
    {
      "source": "/tiktok/retorno",
      "destination": "/api/redes?acao=tiktok_retorno"
    },
    {
      "source": "/midia/:arquivo",
      "destination": "/api/redes?arquivo=:arquivo"
    },
    {
      "source": "/l/:k",
      "destination": "/api/webhook?l=:k"
    }
  ]
}
