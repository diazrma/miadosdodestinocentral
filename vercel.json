{
  "functions": {
    "api/sync.js": {
      "maxDuration": 60
    },
    "api/publicar.js": {
      "maxDuration": 60
    },
    "api/sussurro.js": {
      "maxDuration": 60
    },
    "api/meme.js": {
      "maxDuration": 60
    },
    "api/redes.js": {
      "maxDuration": 60
    },
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sussurro",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/redes?horario=a",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/redes?horario=b",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/redes?horario=c",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/instagram/retorno",
      "destination": "/api/instagram?retorno=1"
    },
    {
      "source": "/tiktok/retorno",
      "destination": "/api/redes?acao=tiktok_retorno"
    },
    {
      "source": "/midia/:arquivo",
      "destination": "/api/redes?arquivo=:arquivo"
    }
  ]
}
